{
  "name": "cdk-starter",
  "version": "0.1.0",
  "bin": {
    "cdk-init": "bin/cdk-init.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "npx cdk",
    "cdk:deploy": "npx cdk deploy --profile {yourProfile}",
    "cdk:list": "npx cdk ls --profile {yourProfile}",
    "cdk:watch": "npx cdk watch {yourStackName} --hotswap-fallback --logs --profile {yourProfile}"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "22.7.9",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "aws-cdk": "2.167.1",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.3"
  },
  "dependencies": {
    "aws-cdk-lib": "2.167.1",
    "constructs": "^10.0.0",
    "source-map-support": "^0.5.21",
    "dotenv": "^16.4.5"
  }
}